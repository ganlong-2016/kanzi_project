                                        <propertyTypeReference>BindingItem.RawCode</propertyTypeReference>
                                        <value xmlns:d21p1="http://www.w3.org/2001/XMLSchema"
                                          i:type="d21p1:string">pixelsPerRevolution = 3000.0
pixelsPerDegree     = pixelsPerRevolution / 360.0
scrollX  = {1}.x
degreesX = mod( mod(scrollX, pixelsPerRevolution) + pixelsPerRevolution,pixelsPerRevolution ) / pixelsPerDegree
scrollY  = {0}.y
degreesY = scrollY   / pixelsPerDegree
degreesY = clamp(-45,15,degreesY )
createRotation(degreesY , degreesX, 0)


#sx=MOD({../../../Scroll View 2D/ScrollViewConcept.ScrollPosition}.x,360)
#m = STEP(180,sx)
##Negative Rotation
#n = m * (sx-360)
##Positive Rotation
#p = (1 - m) * sx
#r = (n + p) 
#createRotationY(r)</value>
                                      </d18p1:Value>
