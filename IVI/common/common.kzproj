                        <d11p1:Key>EngineDefined</d11p1:Key>
                        <d11p1:Value>True</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>ExportToEngine</d11p1:Key>
                        <d11p1:Value>True</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>OwnerClass</d11p1:Key>
                        <d11p1:Value>Kanzi.Shapes.ShapeConcept</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineDefaultValue</d11p1:Key>
                        <d11p1:Value>4.000000</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>DefaultValue</d11p1:Key>
                        <d11p1:Value>4.000000</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineType</d11p1:Key>
                        <d11p1:Value>Float</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>DisplayName</d11p1:Key>
                        <d11p1:Value>Stroke Miter Limit</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Tooltip</d11p1:Key>
                        <d11p1:Value>Sets the limit on the ratio of the miter length to the stroke thickness. When the limit is exceeded, the stroke join style falls back to bevel. This property has an effect only when Stroke Join is Miter.</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Editor</d11p1:Key>
                        <d11p1:Value>Slider</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Host</d11p1:Key>
                        <d11p1:Value>Kanzi.Shapes.Shape2D:context, Kanzi.Shapes.Shape3D:context</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>LowerBound</d11p1:Key>
                        <d11p1:Value>0</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>UpperBound</d11p1:Key>
                        <d11p1:Value>10</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Step</d11p1:Key>
                        <d11p1:Value>0.1</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>LegacyName</d11p1:Key>
                        <d11p1:Value>VectorShape2D.StrokeMiterLimit</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
