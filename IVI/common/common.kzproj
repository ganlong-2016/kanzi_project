                  <d6p1:EnginePropertyDefinition>
                    <d6p1:fields xmlns:d11p1="http://schemas.microsoft.com/2003/10/Serialization/Arrays">
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Name</d11p1:Key>
                        <d11p1:Value>Shapes.ShapeConcept.StrokeCap</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineDefined</d11p1:Key>
                        <d11p1:Value>True</d11p1:Value>
