                  </d9p1:KeyValueOfstringstring>
                  <d9p1:KeyValueOfstringstring>
                    <d9p1:Key>DisplayName</d9p1:Key>
                    <d9p1:Value>SVG Image 3D</d9p1:Value>
                  </d9p1:KeyValueOfstringstring>
                  <d9p1:KeyValueOfstringstring>
                    <d9p1:Key>FrequentlyAddedProperties</d9p1:Key>
