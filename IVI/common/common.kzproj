                        <d11p1:Value>1.000000</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineType</d11p1:Key>
                        <d11p1:Value>Float</d11p1:Value>
