                        <d11p1:Value>True</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>ExportToEngine</d11p1:Key>
                        <d11p1:Value>True</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>OwnerClass</d11p1:Key>
                        <d11p1:Value>Kanzi.Shapes.ShapeConcept</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineDefaultValue</d11p1:Key>
                        <d11p1:Value>1</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>DefaultValue</d11p1:Key>
                        <d11p1:Value>1</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineType</d11p1:Key>
                        <d11p1:Value>Int</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>DisplayName</d11p1:Key>
                        <d11p1:Value>Stroke Join</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Tooltip</d11p1:Key>
                        <d11p1:Value>Sets the style of the area that is formed by two strokes whose ends meet or overlap:
- Round uses a round corner.
- Miter uses a sharp corner. This is the default value.
- Bevel uses a bevelled corner.</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>ValueProvider</d11p1:Key>
                        <d11p1:Value>Enum:Round |0;Miter |1;Bevel |2</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Host</d11p1:Key>
                        <d11p1:Value>Kanzi.Shapes.Ellipse2D:freq,Kanzi.Shapes.Ellipse3D:freq,Kanzi.Shapes.Path2D:freq,Kanzi.Shapes.Path3D:freq,Kanzi.Shapes.Rectangle2D:freq,Kanzi.Shapes.Rectangle3D:freq,Kanzi.Shapes.Line2D:context,Kanzi.Shapes.Line3D:context</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>LegacyName</d11p1:Key>
                        <d11p1:Value>VectorShape2D.StrokeJoin</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                    </d6p1:fields>
                  </d6p1:EnginePropertyDefinition>
                  <d6p1:EnginePropertyDefinition>
                    <d6p1:fields xmlns:d11p1="http://schemas.microsoft.com/2003/10/Serialization/Arrays">
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Name</d11p1:Key>
                        <d11p1:Value>Shapes.ShapeConcept.StrokeAlignment</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineDefined</d11p1:Key>
                        <d11p1:Value>True</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>ExportToEngine</d11p1:Key>
                        <d11p1:Value>True</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>OwnerClass</d11p1:Key>
                        <d11p1:Value>Kanzi.Shapes.ShapeConcept</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineDefaultValue</d11p1:Key>
                        <d11p1:Value>0</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>DefaultValue</d11p1:Key>
                        <d11p1:Value>0</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>EngineType</d11p1:Key>
                        <d11p1:Value>Int</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>DisplayName</d11p1:Key>
                        <d11p1:Value>Stroke Alignment</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Tooltip</d11p1:Key>
                        <d11p1:Value>Sets the alignment of the stroke relative to the shape boundary. The default is Center.
You can use this property in a node that draws a closed shape.</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>ValueProvider</d11p1:Key>
                        <d11p1:Value>Enum:Center |0;Inside |1;Outside |2</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                      <d11p1:KeyValueOfstringstring>
                        <d11p1:Key>Host</d11p1:Key>
                        <d11p1:Value>Kanzi.Shapes.Ellipse2D:freq,Kanzi.Shapes.Ellipse3D:freq,Kanzi.Shapes.Path2D:freq,Kanzi.Shapes.Path3D:freq,Kanzi.Shapes.Rectangle2D:freq,Kanzi.Shapes.Rectangle3D:freq,Kanzi.Shapes.CompositeShape2D:freq,Kanzi.Shapes.CompositeShape3D:freq,Kanzi.Shapes.Line2D:context,Kanzi.Shapes.Line3D:context</d11p1:Value>
                      </d11p1:KeyValueOfstringstring>
                    </d6p1:fields>
