                    <d9p1:Key>Icon</d9p1:Key>
                    <d9p1:Value></d9p1:Value>
                  </d9p1:KeyValueOfstringstring>
                  <d9p1:KeyValueOfstringstring>
                    <d9p1:Key>Name</d9p1:Key>
                    <d9p1:Value>Kanzi.Shapes.SVGImage3D</d9p1:Value>
                  </d9p1:KeyValueOfstringstring>
                  <d9p1:KeyValueOfstringstring>
                    <d9p1:Key>Tooltip</d9p1:Key>
